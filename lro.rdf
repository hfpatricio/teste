        <rdakit:toolkitDefinition xml:lang="no">En enkelt forekomst av en manifestasjon.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="da">Enkelt forekomst af en manifestation.</rdakit:toolkitDefinition>
