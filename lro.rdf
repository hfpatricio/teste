        <rdfs:comment xml:lang="en">The manifestation may be manufactured or produced through industrial processes or through artisanal methods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">manufactured</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to a manifestation for which the agent is responsible for the fabrication, production or manufacture of items</skos:definition>
    </owl:ObjectProperty>
    


