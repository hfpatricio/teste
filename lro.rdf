    <!-- http://rdaregistry.info/Elements/c/C10011 -->

    <owl:Class rdf:about="http://rdaregistry.info/Elements/c/C10011">
        <rdfs:subClassOf rdf:resource="http://rdaregistry.info/Elements/c/C10002"/>
        <rdakit:toolkitDefinition xml:lang="fr">Agent qui est un groupement ou une association de deux ou plusieurs personnes portant un nom particulier et disposant de la faculté d’agir collectivement.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="da">Agent, som er en forsamling eller organisation af to eller felere personer med et bestemt namn, der kan agere som en enhed.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="en">An agent who is a gathering or organization of two or more persons that bears a particular name and that is capable of acting as a unit.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="nl">Een actor die is een bijeenkomst of organisatie van twee of meer personen dat een specifieke naam draagt en dat in staat is om op te treden als een eenheid.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="de">Ein Akteur, bei dem es sich um eine Zusammenkunft oder eine Organisation von zwei oder mehreren Personen handelt, die der einen bestimmten Namen trägt und imstande ist, als Einheit zu handeln.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="no">En samling av eller organisasjon av personer som har et eget navn og som er i stand til å opptre som en enhet.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="it">Gruppo o organizzazione di persone contraddistinto da un nome specifico e in grado di agire come un&apos;unità </rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="et">Isikute rühm või organisatsioon, millel on kindel nimi ja mis on võimeline tegutsema üksusena.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="vi">Một tập hợp hoặc tổ chức của các cá nhân có tên riêng và có thể hoạt động như là một đơn vị.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="lv">Personu kopums vai organizācija, kas izmanto īpašu nosaukumu un darbojas kā vienība.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ca">Reunió o organització de persones que porten un nom concret i capaç d’actuar com una unitat.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="hu">Személyek csoportosulása vagy szervezete, amely saját névvel rendelkezik és egy egységként képes cselekedni</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="fi">Toimija, joka on useamman kuin yhden henkilön kokoontuminen tai organisaatio, jolla on tietty nimi ja joka on kykenevä toimimaan yksikkönä.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="el">Μια συνένωση ή οργανισμός φυσικών προσώπων που φέρουν ένα συγκεκριμένο όνομα και δύνανται να δρουν ως ομάδα.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ar">وكيل عبارة عن تجمع أو تنظيم من شخصين أو أكثر يحملون اسما محددا ويمكنهم التعامل كوحدة .</rdakit:toolkitDefinition>
        <rdakit:toolkitLabel xml:lang="fr">Agent collectif</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="ca">Agent col·lectiu</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="nl">Collectieve actor</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="en">Collective Agent</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="de">Gemeinschaftlicher Akteur</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="et">Kollektiiv</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="da">Kollektiv Agent</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="no">Kollektiv agent</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="hu">Kollektív Ágens</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="fi">Yhteistoimija</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="lv">grupa</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="vi">tác nhân tập thể</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="el">συλλογικός φορέας</rdakit:toolkitLabel>
        <rdakit:toolkitLabel xml:lang="ar">وكيل جماعي</rdakit:toolkitLabel>
        <regap:lexicalAlias rdf:resource="http://rdaregistry.info/Elements/c/CollectiveAgent.en"/>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/c/"/>
        <rdfs:label xml:lang="de">Gemeinschaftlicher Akteur</rdfs:label>
        <rdfs:label xml:lang="fr">agent collectif</rdfs:label>
        <rdfs:label xml:lang="ca">agent col·lectiu</rdfs:label>
        <rdfs:label xml:lang="it">agente collettivo</rdfs:label>
        <rdfs:label xml:lang="nl">collectieve actor</rdfs:label>
        <rdfs:label xml:lang="en">collective agent</rdfs:label>
        <rdfs:label xml:lang="lv">grupa</rdfs:label>
        <rdfs:label xml:lang="et">kollektiiv</rdfs:label>
        <rdfs:label xml:lang="da">kollektiv agent</rdfs:label>
        <rdfs:label xml:lang="no">kollektiv agent</rdfs:label>
        <rdfs:label xml:lang="hu">kollektív ágens</rdfs:label>
        <rdfs:label xml:lang="vi">tác nhân tập thể</rdfs:label>
        <rdfs:label xml:lang="fi">yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="el">συλλογικός φορέας</rdfs:label>
        <rdfs:label xml:lang="ar">وكيل جماعي</rdfs:label>
        <skos:definition xml:lang="fr">Agent qui est un groupement ou une association de deux ou plusieurs personnes portant un nom particulier et disposant de la faculté d’agir collectivement.</skos:definition>
        <skos:definition xml:lang="da">Agent, som er en forsamling eller organisation af to eller felere personer med et bestemt namn, der kan agere som en enhed.</skos:definition>
        <skos:definition xml:lang="en">An agent who is a gathering or organization of two or more persons that bears a particular name and that is capable of acting as a unit.</skos:definition>
        <skos:definition xml:lang="nl">Een actor die is een bijeenkomst of organisatie van twee of meer personen dat een specifieke naam draagt en dat in staat is om op te treden als een eenheid.</skos:definition>
        <skos:definition xml:lang="de">Ein Akteur, bei dem es sich um eine Zusammenkunft oder eine Organisation von zwei oder mehreren Personen handelt, die der einen bestimmten Namen trägt und imstande ist, als Einheit zu handeln.</skos:definition>
        <skos:definition xml:lang="no">En samling av eller organisasjon av personer som har et eget navn og som er i stand til å opptre som en enhet.</skos:definition>
        <skos:definition xml:lang="it">Gruppo o organizzazione di persone contraddistinto da un nome specifico e in grado di agire come un&apos;unità </skos:definition>
        <skos:definition xml:lang="et">Isikute rühm või organisatsioon, millel on kindel nimi ja mis on võimeline tegutsema üksusena.</skos:definition>
        <skos:definition xml:lang="vi">Một tập hợp hoặc tổ chức của các cá nhân có tên riêng và có thể hoạt động như là một đơn vị.</skos:definition>
        <skos:definition xml:lang="lv">Personu kopums vai organizācija, kas izmanto īpašu nosaukumu un darbojas kā vienība.</skos:definition>
        <skos:definition xml:lang="ca">Reunió o organització de persones que porten un nom concret i capaç d’actuar com una unitat.</skos:definition>
        <skos:definition xml:lang="hu">Személyek csoportosulása vagy szervezete, amely saját névvel rendelkezik és egy egységként képes cselekedni.</skos:definition>
        <skos:definition xml:lang="fi">Toimija, joka on useamman kuin yhden henkilön kokoontuminen tai organisaatio, jolla on tietty nimi ja joka on kykenevä toimimaan yksikkönä.</skos:definition>
        <skos:definition xml:lang="el">Μια συνένωση ή οργανισμός φυσικών προσώπων που φέρουν ένα συγκεκριμένο όνομα και δύνανται να δρουν ως ομάδα.</skos:definition>
        <skos:definition xml:lang="ar">وكيل عبارة عن تجمع أو تنظيم من شخصين أو أكثر يحملون اسما محددا ويمكنهم التعامل كوحدة .</skos:definition>
        <skos:scopeNote xml:lang="en">A collective agent includes a corporate body and a family.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Agente collettivo comprende ente e famiglia</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Körperschaften und Familien.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een collectieve actor omvat een corporatie en een familie.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy kollektív ágens magába foglal egy testületet és egy családot.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En kollektiv agent inkluderer korporasjon og familie.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Grupa ietver institūciju un dzimtu/ģimeni.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kollektiivid on asutus ja perekond.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Kollektiv agent omfatter en korporation og en familie</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un agent collectif comprend une collectivité et une famille.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un agent col·lectiu inclou una entitat corporativa i una família.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Yhteistoimija kattaa yhteisön ja suvun.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας συλλογικός φορέας περιλαμβάνει ένα συλλογικό όργανο και μια οικογένεια.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">وكيل جماعي يشمل هيئة وعائلة.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://rdaregistry.info/Elements/c/C10012 -->

    <owl:Class rdf:about="http://rdaregistry.info/Elements/c/C10012">
        <rdfs:subClassOf rdf:resource="http://rdaregistry.info/Elements/c/C10013"/>
        <rdakit:toolkitDefinition xml:lang="en">A label for any RDA entity except a nomen.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="lv">Apzīmējums, kas attiecas uz RDA entīti.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="da">Betegnelse for enhver RDA-entitet, undtaget et nomen.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ca">Designació que es refereix a una entitat RDA.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="it">Designazione che si riferisce a un&apos;entità RDA</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="nl">Een aanduiding voor enige RDA-entiteit behalve een nomen.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="hu">Egy megnevezés, amely egy RDA-entitásra utal.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="de">Ein Label für eine beliebige RDA-Entität. Nomen selbst sind davon ausgenommen.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="no">En betegnelse som henviser til en RDA-entitet.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="vi">Một định danh đề cập tới một thực thể RDA.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="fi">Nimike mille tahansa RDA-entiteetille nomenia lukuun ottamatta</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="et">Tähistus, mis osutab RDA olemile.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="fr">Étiquette pour toute entité RDA à l’exception d’un nomen.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="el">Ένας προσδιορισμός που αναφέρεται σε μια οντότητα RDA.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ar">وسم لأي كيان &quot;وام&quot; باستثناء التسمية.</rdakit:toolkitDefinition>
        <rdakit:toolkitLabel xml:lang="it">Designazione che si riferisce a un&apos;entità RDA</rdakit:toolkitLabel>
