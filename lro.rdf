    </owl:Class>
    


    <!-- http://id.loc.gov/ontologies/bibframe/Temporal -->

    <owl:Class rdf:about="http://id.loc.gov/ontologies/bibframe/Temporal">
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Temporal concept</rdfs:label>
