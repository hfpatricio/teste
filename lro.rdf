    </owl:DatatypeProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/musicThematicNumber -->

    <owl:DatatypeProperty rdf:about="http://id.loc.gov/ontologies/bibframe/musicThematicNumber">
