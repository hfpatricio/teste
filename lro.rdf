        <skos:definition xml:lang="el">Μια δεδομένη χωρική έκταση.</skos:definition>
        <skos:definition xml:lang="ar">حيز مكاني معين.</skos:definition>
    </owl:Class>
    


    <!-- http://rdaregistry.info/Elements/c/C10010 -->

    <owl:Class rdf:about="http://rdaregistry.info/Elements/c/C10010">
        <rdfs:subClassOf rdf:resource="http://rdaregistry.info/Elements/c/C10013"/>
        <rdakit:toolkitDefinition xml:lang="en">A finite period of time.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="et">Ajaline ulatus, millel on algus, lõpp ja kestus.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="fi">Ajan rajallinen jakso.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="da">Begrænset tidsrum</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="nl">Een eindige periode van tijd.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="de">Eine definierte Zeitangabe.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="it">Estensione temporale che a un&apos;inizio, una fine e una durata</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="no">Et omfang av tid med en begynnelse, varighet og slutt.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ca">Extensió temporal que té un principi, un final i una durada.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="hu">Időbeli kiterjedés, aminek van kezdete, vége és hossza.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="lv">Laika apjoms, kuram ir sākums, beigas un ilgums.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="vi">Một quy mô thời gian có bắt đầu, kết thúc và khoảng thời gian.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="fr">Période de temps déterminée.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="el">Μια χρονική έκταση με αρχή, τέλος και διάρκεια.</rdakit:toolkitDefinition>
        <rdakit:toolkitDefinition xml:lang="ar">فترة زمنية محددة</rdakit:toolkitDefinition>
