    </owl:Class>
    


    <!-- http://id.loc.gov/ontologies/bibframe/UsePolicy -->

    <owl:Class rdf:about="http://id.loc.gov/ontologies/bibframe/UsePolicy">
        <rdfs:subClassOf rdf:resource="http://id.loc.gov/ontologies/bibframe/UsageAndAccessPolicy"/>
