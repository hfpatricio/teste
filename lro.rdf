    </owl:Class>
    


    <!-- http://id.loc.gov/ontologies/bibframe/VideoRecordingNumber -->

    <owl:Class rdf:about="http://id.loc.gov/ontologies/bibframe/VideoRecordingNumber">
        <rdfs:subClassOf rdf:resource="http://id.loc.gov/ontologies/bibframe/Identifier"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (Corrected case in class name)</terms:modified>
