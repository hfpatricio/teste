        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Expression of</rdfs:label>
        <skos:definition>Work that the described Work is an expression of. For use to connect Works under FRBR/RDA rules.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/extent -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/extent">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Extent"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Extent</rdfs:label>
        <skos:definition>Number and type of units and/or subunits making up a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/findingAid -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/findingAid">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompaniedBy"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/findingAidOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Finding aid</rdfs:label>
        <skos:definition>Relationship for archival, visual, and manuscript resources to a finding aid or similar control materials.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/findingAidOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/findingAidOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompanies"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Finding aid for</rdfs:label>
        <skos:definition>Finding aid or similar control materials for archival, visual, and manuscript resources.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/fontSize -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/fontSize">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/FontSize"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Font size</rdfs:label>
        <skos:definition>Size of the type used to represent the characters and symbols in a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/frequency -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/frequency">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Frequency"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Frequency</rdfs:label>
        <skos:definition>Intervals at which the parts of a serially produced resource or the updates to an integrating resource are issued.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/generation -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/generation">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Generation"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Generation</rdfs:label>
        <skos:definition>Relationship between an original carrier and the carrier of a reproduction made from the original.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/generationProcess -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/generationProcess">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/AdminMetadata"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/GenerationProcess"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Description generation</rdfs:label>
        <skos:definition>Indication of the program or process used to generate the description by application of a particular transformation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/genreForm -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/genreForm">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/GenreForm"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Genre/form</rdfs:label>
        <skos:definition>Form category or genre to which a resource belongs</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/geographicCoverage -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/geographicCoverage">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/GeographicCoverage"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-06 (Changed from data to object property)</terms:modified>
        <rdfs:label>Geographic coverage</rdfs:label>
        <skos:definition>Geographic coverage of the content of the resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/grantingInstitution -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/grantingInstitution">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Dissertation"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Agent"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Degree issuing institution</rdfs:label>
        <skos:definition>Name of degree granting institution.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasDerivative -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasDerivative">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Has derivative</rdfs:label>
        <skos:definition>Resource that is a modification of the described work.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasEquivalent -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasEquivalent">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Expected value Work, Instance or Item</rdfs:comment>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Equivalence</rdfs:label>
        <skos:definition>Resource embodies the same content as the described resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasExpression -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasExpression">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Expressed as</rdfs:label>
        <skos:definition>Work that is an expression of a described Work. For use to relate Works under FRBR/RDA rules.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasInstance -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasInstance">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/instanceOf"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Instance of Work</rdfs:label>
        <skos:definition>Instance is related to described Work. For use to connect Works to Instances in the BIBFRAME structure.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasItem -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasItem">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/itemOf"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <terms:modified>2017-02-07 (slight revision of definition)</terms:modified>
        <rdfs:label>Has holding</rdfs:label>
        <skos:definition>Item which is an example of the described Instance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasPart -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasPart">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/partOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work, Instance or Item</rdfs:comment>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Has part</rdfs:label>
        <skos:definition>Resource that is included either physically or logically in the described resource</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasReproduction -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasReproduction">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasEquivalent"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/reproductionOf"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Reproduced as</rdfs:label>
        <skos:definition>Resource that reproduces another Resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasSeries -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasSeries">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/partOf"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/seriesOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>In series</rdfs:label>
        <skos:definition>Resource in which the part has been issued; the title of the larger resource appears on the part.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/hasSubseries -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/hasSubseries">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/partOf"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/subseriesOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Subseries</rdfs:label>
        <skos:definition>series resource that is part of another series.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/heldBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/heldBy">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Agent"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Held by</rdfs:label>
        <skos:definition>Entity holding the item or from which it is available.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/identifiedBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/identifiedBy">
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/identifies"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Identifier"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-05-04 (New inverse)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Identifier</rdfs:label>
        <skos:definition>Character string associated with a resource that serves to differentiate that resource from other resources, i.e., that uniquely identifies an entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/identifies -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/identifies">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Identifier"/>
        <terms:modified>2017-02-03 (New inverse)</terms:modified>
        <rdfs:label>Resource identified</rdfs:label>
        <skos:definition>Resource that is associated with a character string that serves to differentiate one resource from another.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/illustrativeContent -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/illustrativeContent">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Illustration"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Illustrative content information</rdfs:label>
        <skos:definition>Information about content intended to illustrate a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/immediateAcquisition -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/immediateAcquisition">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ImmediateAcquisition"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-06 (Changed from data to object property)</terms:modified>
        <rdfs:label>Immediate acquisition</rdfs:label>
        <skos:definition>Information about the circumstances, e.g., source, date, method, under which the resource was directly acquired.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/index -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/index">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompaniedBy"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/indexOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <terms:modified>2017-02-03 (corrected label)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Has index</rdfs:label>
        <skos:definition>Resource has an accompanying index</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/indexOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/indexOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompanies"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Index to</rdfs:label>
        <skos:definition>Index that accompanies a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/instanceOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/instanceOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Instance of</rdfs:label>
        <skos:definition>Work the Instance described instantiates or manifests. For use to connect Instances to Works in the BIBFRAME structure.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/instrument -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/instrument">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/MusicInstrument"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Instrument</rdfs:label>
        <skos:definition>Instrument for which a musical Work is appropriate.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/intendedAudience -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/intendedAudience">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/IntendedAudience"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Intended audience</rdfs:label>
        <skos:definition>Information that identifies the specific audience or intellectual level for which the content of the resource is considered appropriate.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/issuance -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/issuance">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Issuance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Mode of issuance</rdfs:label>
        <skos:definition>Categorization reflecting whether a resource is issued in one or more parts, the way it is updated, and its intended termination.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/issuedWith -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/issuedWith">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompanies"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Issued with</rdfs:label>
        <skos:definition>Resource that is issued on the same carrier as the resource being described.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/itemOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/itemOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <terms:modified>2017-02-07 (slight revision of definition)</terms:modified>
        <rdfs:label>Holding for</rdfs:label>
        <skos:definition>Instance for which the described Item is an example.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/language -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/language">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://id.loc.gov/ontologies/bibframe/Audio"/>
                    <rdf:Description rdf:about="http://id.loc.gov/ontologies/bibframe/Cartography"/>
                    <rdf:Description rdf:about="http://id.loc.gov/ontologies/bibframe/Text"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Language"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Language information</rdfs:label>
        <skos:definition>Language associated with a resource or its parts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/layout -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/layout">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Layout"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Layout</rdfs:label>
        <skos:definition>Arrangement of text, images, tactile notation, etc., in a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/media -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/media">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Media"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Media type</rdfs:label>
        <skos:definition>Categorization reflecting the general type of intermediation device required to view, play, run, etc., the content of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/mergedToForm -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/mergedToForm">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/succeededBy"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/mergerOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Merged to form</rdfs:label>
        <skos:definition>One of two or more resources that come together to form a new resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/mergerOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/mergerOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/precededBy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Merger of</rdfs:label>
        <skos:definition>One of two or more resources which came together to form a new resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/mount -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/mount">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Mount"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Mount material</rdfs:label>
        <skos:definition>Physical material used for the support or backing to which the base material of a resource has been attached.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/musicFormat -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/musicFormat">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/MusicFormat"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Format of notated music</rdfs:label>
        <skos:definition>Layout for content of a resource that is presented in the form of musical notation, such as full score, condensed score, vocal score, etc.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/musicMedium -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/musicMedium">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/MusicMedium"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Music medium of performance</rdfs:label>
        <skos:definition>Instrumental, vocal, and/or other medium of performance for which a musical resource was originally conceived, written or performed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/notation -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/notation">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Notation"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Notation system</rdfs:label>
        <skos:definition>Alphabet, script, or symbol system used to convey the content of the resource, including specialized scripts, typefaces, tactile notation, movement notation, and musical notation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/note -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/note">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Note"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Note</rdfs:label>
        <skos:definition>General textual information relating to a resource, such as Information about a specific copy of a resource or information about a particular attribute of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/originPlace -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/originPlace">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/place"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Place"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Associated title place</rdfs:label>
        <skos:definition>Place from which the creation of the Work originated.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/originalVersion -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/originalVersion">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/derivativeOf"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/originalVersionOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Original version</rdfs:label>
        <skos:definition>Resource is the original version of which this resource is a reproduction.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/originalVersionOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/originalVersionOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasDerivative"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Original version of</rdfs:label>
        <skos:definition>Original version of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/otherEdition -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/otherEdition">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/derivativeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-05-13 (symmetrical)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Other edition</rdfs:label>
        <skos:definition>Resource has other available editions, for example simultaneously published language editions or reprints.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/otherPhysicalFormat -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/otherPhysicalFormat">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasEquivalent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Has other physical format</rdfs:label>
        <skos:definition>Resource that is manifested in another physical carrier.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/partOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/partOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work, Instance or Item</rdfs:comment>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Is part of</rdfs:label>
        <skos:definition>Resource in which the described resource is physically or logically contained.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/place -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/place">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Place"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Place</rdfs:label>
        <skos:definition>Geographic location or place entity associated with a resource or element of description, such as the place associated with the publication, printing, distribution, issue, release or production of a resource, place of an event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/polarity -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/polarity">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Polarity"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Polarity</rdfs:label>
        <skos:definition>Relationship of the colors and tones in an image to the colors and tones of the object reproduced.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/precededBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/precededBy">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/succeededBy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Preceded by</rdfs:label>
        <skos:definition>Resource that precedes the resource being described, e.g., is earlier in time or before in narrative.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/productionMethod -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/productionMethod">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ProductionMethod"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Production method</rdfs:label>
        <skos:definition>Process used to produce a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/projection -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/projection">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Cartographic"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Projection"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (changed from data to object property)</terms:modified>
        <rdfs:label>Cartographic projection</rdfs:label>
        <skos:definition>Method or system used to represent the surface of the earth or of a celestial sphere on a plane.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/projectionCharacteristic -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/projectionCharacteristic">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ProjectionCharacteristic"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (fixed typo in property name)</terms:modified>
        <rdfs:label>Projection characteristic</rdfs:label>
        <skos:definition>Technical specification relating to the projection of a motion picture film.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/provisionActivity -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/provisionActivity">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ProvisionActivity"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (revised label and slightly revised definition)</terms:modified>
        <rdfs:label>Provision activity</rdfs:label>
        <skos:definition>Place, name, and/or date information relating to the publication, printing, distribution, issue, release, production, etc. of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/reductionRatio -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/reductionRatio">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ReductionRatio"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Reduction ratio</rdfs:label>
        <skos:definition>Size of a micro-image in relation to the original from which it was produced.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/referencedBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/referencedBy">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/references"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work, Instance or Item</rdfs:comment>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Referenced by</rdfs:label>
        <skos:definition>Resource that references the described resource</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/references -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/references">
        <owl:equivalentProperty rdf:resource="https://purl.org/LRO/lro.owl#assunto"/>
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work, Instance or Item</rdfs:comment>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>References</rdfs:label>
        <skos:definition>Resource that is referenced by the described resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/relatedTo -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/relatedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Related resource</rdfs:label>
        <skos:definition>Any relationship between Work, Instance, and Item resources.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/replacedBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/replacedBy">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/succeededBy"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/replacementOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Succeeded by</rdfs:label>
        <skos:definition>Later resource used in place of an earlier resource, usually because the later resource contains updated or new information.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/replacementOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/replacementOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/precededBy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Preceded by</rdfs:label>
        <skos:definition>Earlier resource whose content has been replaced by a later resource, usually because the later resource contains updated or new information.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/reproductionOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/reproductionOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasEquivalent"/>
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:label>Reproduction of</rdfs:label>
        <skos:definition>Resource that is a reproduction of another Resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/review -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/review">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Review"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Review content</rdfs:label>
        <skos:definition>Review of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/role -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/role">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Contribution"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Role"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (Changed from data to object property, adjusted label and definition)</terms:modified>
        <rdfs:label>Contributor role</rdfs:label>
        <skos:definition>Function provided by a contributor, e.g., author, illustrator, etc.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/scale -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/scale">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Scale"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-03 (changed from data to object property)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Scale</rdfs:label>
        <skos:definition>Ratio of the dimensions of a form contained or embodied in a resource to the dimensions of the entity it represents, e.g., for images or cartographic resources.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/separatedFrom -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/separatedFrom">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/precededBy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Separated from</rdfs:label>
        <skos:definition>Resource that spun off a part of its content to form a new resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/seriesOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/seriesOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasPart"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Series container of</rdfs:label>
        <skos:definition>Resource that is a part of a larger resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/shelfMark -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/shelfMark">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/ShelfMark"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Shelf mark</rdfs:label>
        <skos:definition>Piece identifier, such as a call or other type of number.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/soundCharacteristic -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/soundCharacteristic">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/SoundCharacteristic"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-21 (fixed name and range typos)</terms:modified>
        <rdfs:label>Sound characteristic</rdfs:label>
        <skos:definition>Technical specification relating to the encoding of sound in a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/soundContent -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/soundContent">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/SoundContent"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Sound content</rdfs:label>
        <skos:definition>Indication of whether the production of sound is an integral part of the resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/source -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/source">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Source"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Source</rdfs:label>
        <skos:definition>Resource from which value or label came or was derived, such as the formal source/scheme from which a classification number is taken or derived, list from which an agent name is taken or derived, source within which an identifier is unique.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/splitInto -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/splitInto">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/succeededBy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Split into</rdfs:label>
        <skos:definition>One of two or more resources resulting from the division of an earlier resource into separate resources.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/status -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/status">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Status"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Status</rdfs:label>
        <skos:definition>Designation of the validity or position of something, such as indication that the classification number is canceled or invalid, circulation availability of an item, indication of whether the identifier is canceled or invalid.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/subject -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/subject">
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Subject</rdfs:label>
        <skos:definition>Subject term(s) describing a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/sublocation -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/sublocation">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Item"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Sublocation"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Held in sublocation</rdfs:label>
        <skos:definition>Specific place within the holding entity where the item is located or made available.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/subseriesOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/subseriesOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasPart"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Subseries of</rdfs:label>
        <skos:definition>Series resource of which the described resource is a part.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/succeededBy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/succeededBy">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/relatedTo"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Succeeded by</rdfs:label>
        <skos:definition>Resource that succeeds the resource being described, e.g., later in time or after in a narrative.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/summary -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/summary">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Summary"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Summary content</rdfs:label>
        <skos:definition>Summary or abstract of the resource described.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/supplement -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/supplement">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompaniedBy"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/supplementTo"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Supplement</rdfs:label>
        <skos:definition>Resource that updates or otherwise complements the predominant resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/supplementTo -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/supplementTo">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/accompanies"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Supplement to</rdfs:label>
        <skos:definition>Resource that is updated or otherwise complemented by the augmenting resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/supplementaryContent -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/supplementaryContent">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/SupplementaryContent"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Supplementary material</rdfs:label>
        <skos:definition>Material such as an index, bibliography, appendix intended to supplement the primary content of a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/systemRequirement -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/systemRequirement">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/SystemRequirement"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2017-02-06 (Changed from data to object property, changed property name from plural to singular)</terms:modified>
        <rdfs:label>Equipment or system requirements</rdfs:label>
        <skos:definition>Equipment or system requirement beyond what is normal and obvious for the type of carrier or type of file, such as make and model of equipment or hardware, operating system, amount of memory, programming language, other necessary software, any plug-ins or peripherals required to play, view, or run the resource, etc.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/tableOfContents -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/tableOfContents">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/TableOfContents"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Table of contents content</rdfs:label>
        <skos:definition>Table of contents of the described resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/title -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/title">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Title"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Title resource</rdfs:label>
        <skos:definition>Name given to a resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/translation -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/translation">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/hasDerivative"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/ontologies/bibframe/translationOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <terms:modified>2017-02-03 (corrected subproperty)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Translation as</rdfs:label>
        <skos:definition>Resource that translates the text of the source entity into a language different from that of the original.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/translationOf -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/translationOf">
        <rdfs:subPropertyOf rdf:resource="http://id.loc.gov/ontologies/bibframe/derivativeOf"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <terms:modified>2016-04-29 (added inverse, updated range)</terms:modified>
        <terms:modified>2017-02-03 (corrected subproperty)</terms:modified>
        <rdfs:comment>Expected value Work or Instance</rdfs:comment>
        <rdfs:comment>Used with Work or Instance</rdfs:comment>
        <rdfs:label>Translation of</rdfs:label>
        <skos:definition>Resource that has been translated, i.e., the text is expressed in a language different from that of the original resource.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/unit -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/unit">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/Unit"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Unspecified</rdfs:comment>
        <rdfs:label>Type of unit</rdfs:label>
        <skos:definition>Units in which a value is expressed, such as the physical or logical constituent of a resource (e.g., a volume, audiocassette, film reel, a map, a digital file).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/usageAndAccessPolicy -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/usageAndAccessPolicy">
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/UsageAndAccessPolicy"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:comment>Used with Work, Instance or Item</rdfs:comment>
        <rdfs:label>Use and access condition</rdfs:label>
        <skos:definition>General statement of allowances and restrictions on access to a resource, including retention, reproduction, access, and lending.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/videoCharacteristic -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/videoCharacteristic">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Instance"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/VideoCharacteristic"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Video characteristic</rdfs:label>
        <skos:definition>Technical specification relating to the encoding of video images in a resource</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/ontologies/bibframe/voice -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/ontologies/bibframe/voice">
        <rdfs:domain rdf:resource="http://id.loc.gov/ontologies/bibframe/Work"/>
        <rdfs:range rdf:resource="http://id.loc.gov/ontologies/bibframe/MusicVoice"/>
        <terms:modified>2016-04-21 (New)</terms:modified>
        <rdfs:label>Voice</rdfs:label>
        <skos:definition>Voice for which a musical work is appropriate, such as soprano, tenor, mixed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R1 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R1">
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isAssociatedWithRes"/>
        <regap:name xml:lang="en">isAssociatedWithRes</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a general relationship valid for all entities in the bibliographic universe. In general, specific refinements would be defined to carry more precise semantics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is associated with res</rdfs:label>
        <skos:definition xml:lang="en">Relates two res that have an association of any kind</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R10 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R10">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R10i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isOwnedBy"/>
        <regap:name>isOwnedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between an item and a related agent could serve as the basis both for identifying an agent that owned or had custodianship of an item and for ensuring that all items owned by, or in the custodianship of, a particular agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is owned by</rdfs:label>
        <skos:definition xml:lang="en">Relates an item to an agent that is or was the owner or custodian of that item</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R10i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R10i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/owns"/>
        <regap:name>owns</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between an item and a related agent could serve as the basis both for identifying an agent that owned or had custodianship of an item and for ensuring that all items owned by, or in the custodianship of, a particular agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">owns</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to an item that is or was owned or in the custody of that agent</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R11 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R11">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R11i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasModifiedBy"/>
        <regap:name>wasModifiedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Examples include adding annotations, adding an ex-libris, removing pages, rebinding, restoration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was modified by</rdfs:label>
        <skos:definition xml:lang="en">Relates an item to an agent that made changes to this particular item without creating a new manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R11i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R11i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/modified"/>
        <regap:name>modified</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Examples include adding annotations, adding an ex-libris, removing pages, rebinding, restoration.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">modified</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to an item that the agent made changes to without creating a new manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R12 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R12">
        <owl:equivalentProperty rdf:resource="https://purl.org/LRO/lro.owl#assunto"/>
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R12i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasAsSubject"/>
        <regap:name>hasAsSubject</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between a work and a related subject entity serves as the basis both for identifying the subject of an individual work and for ensuring that all works relevant to a given subject are linked to that subject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has as subject</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to its topic(s)</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R12i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R12i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isSubjectOf"/>
        <regap:name>isSubjectOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between a work and a related subject entity serves as the basis both for identifying the subject of an individual work and for ensuring that all works relevant to a given subject are linked to that subject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is subject of</rdfs:label>
        <skos:definition xml:lang="en">Relates any res to a work in which that res is a topic</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R13 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R13">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R13i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasAppellation"/>
        <regap:name>hasAppellation</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The consequence of the definition of nomen as the association between something and a designation that refers to it, is that each nomen is uniquely associated with a single res within a given scheme (which can extend from a specific local system to a natural language, through a shared authority file). The resulting cardinality of the appellation relationship is that while a single res may have many nomens, each nomen is the appellation of a single res. The fact that two instances of nomen may have the same value for their nomen string attribute does not modify this cardinality, and does not imply that such instances of nomen are actually one and the same instance of nomen associated with more than one instance of res, even if the scheme in question is a natural language. The nomen string &quot;Gift&quot; may be used to refer either to a present or to a poison, according to whether it is the nomen string value for a nomen within the English language or for a nomen in the German language: although the string nomen values look the same, we do have here two distinct instances of nomen for two distinct instances of res. Although in theory, one instance of nomen (a subclass of res) could be associated to another instance of nomen via the appellation relationship (resulting in a nomen for another nomen), in practice the general case would not be provided for in implementations. Structurally, in a system implementation where instances of the entity nomen are assigned an internal identifier (also a nomen of a specific type) this relationship would be implicit in the system design. An example of this situation could be found in a linked data implementation which assigns a URI (nomen) to instances of nomen of other types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has appellation</rdfs:label>
        <skos:definition xml:lang="en">Relates an entity with a sign or combination of signs or symbols through which that entity is referred to within a given scheme or context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R13i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R13i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isAppellationOf"/>
        <regap:name>isAppellationOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The consequence of the definition of nomen as the association between something and a designation that refers to it, is that each nomen is uniquely associated with a single res within a given scheme (which can extend from a specific local system to a natural language, through a shared authority file). The resulting cardinality of the appellation relationship is that while a single res may have many nomens, each nomen is the appellation of a single res. The fact that two instances of nomen may have the same value for their nomen string attribute does not modify this cardinality, and does not imply that such instances of nomen are actually one and the same instance of nomen associated with more than one instance of res, even if the scheme in question is a natural language. The nomen string &quot;Gift&quot; may be used to refer either to a present or to a poison, according to whether it is the nomen string value for a nomen within the English language or for a nomen in the German language: although the string nomen values look the same, we do have here two distinct instances of nomen for two distinct instances of res. Although in theory, one instance of nomen (a subclass of res) could be associated to another instance of nomen via the appellation relationship (resulting in a nomen for another nomen), in practice the general case would not be provided for in implementations. Structurally, in a system implementation where instances of the entity nomen are assigned an internal identifier (also a nomen of a specific type) this relationship would be implicit in the system design. An example of this situation could be found in a linked data implementation which assigns a URI (nomen) to instances of nomen of other types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is appellation of</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen with an entity referred through that sign or combination of signs or symbols within a given scheme or context</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R14 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R14">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R14i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/assigned"/>
        <regap:name>assigned</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In the bibliographic context, nomen assignment is applied to the creation of subject terms, controlled access points, identifiers, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">assigned</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent with a particular nomen that was assigned by this agent</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R14i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R14i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasAssignedBy"/>
        <regap:name>wasAssignedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In the bibliographic context, nomen assignment is applied to the creation of subject terms, controlled access points, identifiers, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was assigned by</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen to an agent that assigned that particular nomen</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R15 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R15">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isEquivalentTo"/>
        <regap:name>isEquivalentTo</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a shortcut of a fully developed path: NOMEN1 is appellation of RES + RES has appellation NOMEN2. The nomens related by this relationship are functionally equivalent in meaning (assigned to the same res), but as they retain their own values in any attributes that are recorded for them, they are not interchangeable as far as usage is concerned. The equivalent nomens may differ as to crucial attributes such as scheme, language or context of use. This equivalence relationship relates instances of nomens, and not the values of the nomen string attributes for these nomens. Thus, even though it may seem counter-intuitive, two nomens that refer to different res, even if recorded with the same literal string, will not be equivalent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is equivalent to</rdfs:label>
        <skos:definition xml:lang="en">Relates two nomens which are appellations of the same res</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R16 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R16">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R16i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartNomen"/>
        <regap:name>hasPartNomen</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The whole-part relationship for nomens is essential in handling the attributes of components of nomens constructed using pre-existing nomens, as such attributes as language may differ between the parts of a compound nomen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part nomen</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen that is constructed using another nomen as a component to that component</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R16i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R16i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartNomenOf"/>
        <regap:name>isPartNomenOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The whole-part relationship for nomens is essential in handling the attributes of components of nomens constructed using pre-existing nomens, as such attributes as language may differ between the parts of a compound nomen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part nomen of</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen to another nomen constructed using that nomen as a component</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R17 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R17">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R17i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isDerivationNomenOf"/>
        <regap:name>isDerivationNomenOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A nomen may be derived from another due to formal modifications in the notation used (such as transliteration) or cultural or linguistic conventions (creation of abbreviated or shortened or variant forms).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is derivation nomen of</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen with another nomen that was used as the basis for the first nomen, both of which are appellations of the same res</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R17i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R17i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E9"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasDerivationNomen"/>
        <regap:name>hasDerivationNomen</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A nomen may be derived from another due to formal modifications in the notation used (such as transliteration) or cultural or linguistic conventions (creation of abbreviated or shortened or variant forms).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has derivation nomen</rdfs:label>
        <skos:definition xml:lang="en">Relates a nomen with another nomen for which the first nomen formed the basis, both of which are appellations of the same res</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R18 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R18">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R18i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartWork"/>
        <regap:name>hasPartWork</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This applies when the component-to-whole relationship is an inherent aspect of the works and holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works. Examples include movements of concertos, poems within poetry cycles, multipart novels, triptychs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part work</rdfs:label>
        <skos:definition xml:lang="en">Relates two works, where the content of the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R18i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R18i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartWorkOf"/>
        <regap:name>isPartWorkOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This applies when the component-to-whole relationship is an inherent aspect of the works and holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works. Examples include movements of concertos, poems within poetry cycles, multipart novels, triptychs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part work of</rdfs:label>
        <skos:definition xml:lang="en">Relates two works, where the content of the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R19 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R19">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R19i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/precedesWork"/>
        <regap:name>precedesWork</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The relationship is about a sequence of ideas and should not be confused with the time of creation of the respective works. As this relationship concerns the logical continuation of the content of the respective works, it does not apply to those serial works that transform over time (via major title changes, changes in media type, etc.) yet maintain a continuity in their form or numbering schemes. See the work-transformation relationship, LRM-R22, to express the relationship between one aggregating or serial work and another that modifies and continues it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">precedes work</rdfs:label>
        <skos:definition xml:lang="en">Relates two works where the content of the second is a logical continuation of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R19i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R19i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/succeedsWork"/>
        <regap:name>succeedsWork</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The relationship is about a sequence of ideas and should not be confused with the time of creation of the respective works. As this relationship concerns the logical continuation of the content of the respective works, it does not apply to those serial works that transform over time (via major title changes, changes in media type, etc.) yet maintain a continuity in their form or numbering schemes. See the work-transformation relationship, LRM-R22, to express the relationship between one aggregating or serial work and another that modifies and continues it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">succeeds work</rdfs:label>
        <skos:definition xml:lang="en">Relates two works where the content of the first is logically continued by the second</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R2 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R2">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R2i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isRealizedThrough"/>
        <regap:name>isRealizedThrough</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between work and expression, as reflected in the model through this relationship, serves as the basis both for identifying the work represented by an individual expression and for ensuring that all expressions of a work are linked to the work. Indirectly the relationships between a work and the various expressions of that work also serve to establish a “sibling” relationship between the various expressions of the work.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is realized through</rdfs:label>
        <skos:definition xml:lang="en">Relates a work with any of the expressions which convey the same intellectual or artistic content</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R20 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R20">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R20i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/accompaniesOrComplements"/>
        <regap:name>accompaniesOrComplements</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The relationship between two works which are independent, but can also be used in conjunction with each other as complements or companions. The two works may be adding value to each other (in this case the relationship is symmetrical); in other cases one of the works is considered secondary.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">accompanies or complements</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to another work that it accompanies or complements</skos:definition>
        <skos:scopeNote xml:lang="en">Source documentation has &quot;accompanies / complements&quot;; slash character replaced with &quot;or&quot; to improve clarity.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R20i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R20i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isAccompaniedOrComplementedBy"/>
        <regap:name>isAccompaniedOrComplementedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The relationship between two works which are independent, but can also be used in conjunction with each other as complements or companions. The two works may be adding value to each other (in this case the relationship is symmetrical); in other cases one of the works is considered secondary.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is accompanied or complemented by</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to another work which is accompanied or complemented by the first work</skos:definition>
        <skos:scopeNote xml:lang="en">Source documentation has &quot;is accompanied / complemented by&quot;; slash character replaced with &quot;or&quot; to improve clarity.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R21 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R21">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R21i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isInspirationFor"/>
        <regap:name>isInspirationFor</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is inspiration for</rdfs:label>
        <skos:definition xml:lang="en">Relates two works where the content of the first served as the source of ideas for the second</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R21i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R21i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isInspiredBy"/>
        <regap:name>isInspiredBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is inspired by</rdfs:label>
        <skos:definition xml:lang="en">Relates two works where the source of ideas for the second originated in the content of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R22 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R22">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R22i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isATransformationOf"/>
        <regap:name>isATransformationOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Some transformations may be considered as being only inspired by a previous work.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is a transformation of</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to a previous work from which it was created by changing the scope or editorial policy (as in a serial or aggregating work), the genre or literary form (dramatization, novelization), target audience (adaptation for children), or style (paraphrase, imitation, parody)</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R22i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R22i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasTransformedInto"/>
        <regap:name>wasTransformedInto</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Some transformations may be considered as being only inspired by a previous work.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was transformed into</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to a new work created by changing the scope or editorial policy (as in a serial or aggregating work), the genre or literary form (dramatization, novelization), target audience (adaptation for children), or style (paraphrase, imitation, parody) of the previous work</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R23 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R23">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R23i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartExpression"/>
        <regap:name>hasPartExpression</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This applies when the component-to-whole relationship is an inherent aspect of the works and holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part expression</rdfs:label>
        <skos:definition xml:lang="en">Relates two expressions where the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R23i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R23i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartExpressionOf"/>
        <regap:name>isPartExpressionOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This applies when the component-to-whole relationship is an inherent aspect of the works and holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part expression of</rdfs:label>
        <skos:definition xml:lang="en">Relates two expressions where the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R24 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R24">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R24i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isDerivationExpressionOf"/>
        <regap:name>isDerivationExpressionOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In many cases, the exact source of, for example, a translation, adaptation, revision, or arrangement is not known. If it is, it may be an interesting aspect for the end-user. The derivation relationship may be refined to provide more detailed information about the nature of the transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is derivation expression of</rdfs:label>
        <skos:definition xml:lang="en">Relates two expressions of the same work, where the second was used as the source for the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R24i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R24i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasDerivationExpression"/>
        <regap:name>hasDerivationExpression</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In many cases, the exact source of, for example, a translation, adaptation, revision, or arrangement is not known. If it is, it may be an interesting aspect for the end-user. The derivation relationship may be refined to provide more detailed information about the nature of the transformation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has derivation expression</rdfs:label>
        <skos:definition xml:lang="en">Relates two expressions of the same work, where the first was used as the source for the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R25 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R25">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R25i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasAggregatedBy"/>
        <regap:name>wasAggregatedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">An aggregating expression will select multiple specific expressions of other works so that they can be embodied together in an aggregate manifestation. An expression may be chosen by multiple aggregating expressions. This is a shortcut of the relationships illustrated in Figure 5.8, the general model for aggregates. EXPRESSION1 is embodied in MANIFESTATION (aggregate) + MANIFESTATION (aggregate) embodies (aggregating) EXPRESSION. Unlike the whole-part relationship between expressions, the expressions selected to appear together in the aggregate manifestation do not become components of the aggregating expression. Furthermore, the relationship between these expressions is not an inherent feature of the works that these expressions realize, and thus is does not hold in other expressions of those works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was aggregated by</rdfs:label>
        <skos:definition xml:lang="en">Relates a specific expression of a work chosen as part of the plan of an aggregating expression to the aggregating expression</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R25i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R25i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/aggregated"/>
        <regap:name>aggregated</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">An aggregating expression will select multiple specific expressions of other works so that they can be embodied together in an aggregate manifestation. An expression may be chosen by multiple aggregating expressions. This is a shortcut of the relationships illustrated in Figure 5.8, the general model for aggregates. EXPRESSION1 is embodied in MANIFESTATION (aggregate) + MANIFESTATION (aggregate) embodies (aggregating) EXPRESSION. Unlike the whole-part relationship between expressions, the expressions selected to appear together in the aggregate manifestation do not become components of the aggregating expression. Furthermore, the relationship between these expressions is not an inherent feature of the works that these expressions realize, and thus is does not hold in other expressions of those works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">aggregated</rdfs:label>
        <skos:definition xml:lang="en">Relates an aggregating expression to a specific expression of a work that was chosen as part of the plan of the aggregating expression</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R26 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R26">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R26i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartManifestation"/>
        <regap:name>hasPartManifestation</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In some cases the components of a manifestation are based on physical considerations relating to the carrier in which the manifestation is intended to be issued (for example, a recording is too long to fit on a single disc and is issued in a two-disc boxed set). An alternate manifestation on another carrier may not display the same components. However, in the case when the component-to-whole relationship is an inherent aspect of the works it holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part manifestation</rdfs:label>
        <skos:definition xml:lang="en">Relates two manifestations where the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R26i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R26i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartManifestationOf"/>
        <regap:name>isPartManifestationOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In some cases the components of a manifestation are based on physical considerations relating to the carrier in which the manifestation is intended to be issued (for example, a recording is too long to fit on a single disc and is issued in a two-disc boxed set). An alternate manifestation on another carrier may not display the same components. However, in the case when the component-to-whole relationship is an inherent aspect of the works it holds for all the expressions and manifestations of the larger work and of its component works, whether the expression or manifestation comprises the full larger work or just one or more (but not all) of the component works.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part manifestation of</rdfs:label>
        <skos:definition xml:lang="en">Relates two manifestations where the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R27 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R27">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R27i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasReproductionManifestation"/>
        <regap:name>hasReproductionManifestation</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Generally, for reprints and reissues no specific item of the source manifestation is singled out as the source of the reproduction. Furthermore, in these cases, although a particular item may have been used as a source of reproduction, this item should be considered to represent the source manifestation as a whole. The process of reproduction always results in a new manifestation, even when only a single item was produced from that manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has reproduction manifestation</rdfs:label>
        <skos:definition xml:lang="en">Relates two manifestations providing the end-user with exactly the same content and where an earlier manifestation has provided a source for the creation of a subsequent manifestation, such as facsimiles, reproductions, reprints, and reissues</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R27i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R27i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isReproductionManifestationOf"/>
        <regap:name>isReproductionManifestationOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Generally, for reprints and reissues no specific item of the source manifestation is singled out as the source of the reproduction. Furthermore, in these cases, although a particular item may have been used as a source of reproduction, this item should be considered to represent the source manifestation as a whole. The process of reproduction always results in a new manifestation, even when only a single item was produced from that manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is reproduction manifestation of</rdfs:label>
        <skos:definition xml:lang="en">Relates two manifestations providing the end-user with exactly the same content and where a subsequent manifestation was created using an earlier manifestation as a source, such as facsimiles, reproductions, reprints, and reissues</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R28 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R28">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R28i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasReproductionItem"/>
        <regap:name>hasReproductionItem</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In this case, the particular item used as a source of reproduction is significant, either by its provenance or due to item-specific characteristics such as annotations or ownership markings. The process of reproduction always results in a new manifestation, even when only a single item was produced from that manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has reproduction item</rdfs:label>
        <skos:definition xml:lang="en">Relates an item of one manifestation and another manifestation providing the end-user with exactly the same content and where a specific item has provided a source for the creation of a subsequent manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R28i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R28i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isReproductionItemOf"/>
        <regap:name>isReproductionItemOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In this case, the particular item used as a source of reproduction is significant, either by its provenance or due to item-specific characteristics such as annotations or ownership markings. The process of reproduction always results in a new manifestation, even when only a single item was produced from that manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is reproduction item of</rdfs:label>
        <skos:definition xml:lang="en">Relates a manifestation and a specific item of another manifestation which provided a source for the creation of the subsequent manifestation providing the end-user with exactly the same content</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R29 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R29">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasAlternate"/>
        <regap:name>hasAlternate</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">Typical cases are when a publication, sound recording, video, etc., is issued in more than one format or when it is released simultaneously by different publishers in different countries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has alternate</rdfs:label>
        <skos:definition xml:lang="en">Relates manifestations that effectively serve as alternatives for each other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R2i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R2i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/realizes"/>
        <regap:name>realizes</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between work and expression, as reflected in the model through this relationship, serves as the basis both for identifying the work represented by an individual expression and for ensuring that all expressions of a work are linked to the work. Indirectly the relationships between a work and the various expressions of that work also serve to establish a “sibling” relationship between the various expressions of the work.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">realizes</rdfs:label>
        <skos:definition xml:lang="en">Relates an expression with the work whose intellectual or artistic content it conveys</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R3 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R3">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R3i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isEmbodiedIn"/>
        <regap:name>isEmbodiedIn</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A manifestation may embody one or more expressions and any expression may be embodied in one or more manifestations. This logical connection serves as the basis both for identifying the specific expression or expressions of a work or works embodied in an individual manifestation and for ensuring that all manifestations of the same expression are linked back to that expression.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is embodied in</rdfs:label>
        <skos:definition xml:lang="en">Relates an expression with a manifestation in which the expression appears</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R30 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R30">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R30i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isMemberOf"/>
        <regap:name>isMemberOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A person may explicitly join an organization or association. A person may implicitly become a member of a family by birth, adoption, marriage, etc. A collective agent may join another collective agent as a member.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is member of</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent and a collective agent that the agent joined as a member</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R30i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R30i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasMember"/>
        <regap:name>hasMember</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A person may explicitly join an organization or association. A person may implicitly become a member of a family by birth, adoption, marriage, etc. A collective agent may join another collective agent as a member.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has member</rdfs:label>
        <skos:definition xml:lang="en">Relates a collective agent to an agent that joined the collective agent as a member</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R31 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R31">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R31i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartCollectiveAgent"/>
        <regap:name>hasPartCollectiveAgent</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two collective agents where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part collective agent</rdfs:label>
        <skos:definition xml:lang="en">Relates two collective agents where the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R31i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R31i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartCollectiveAgentOf"/>
        <regap:name>isPartCollectiveAgentOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two collective agents where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part collective agent of</rdfs:label>
        <skos:definition xml:lang="en">Relates two collective agents where the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R32 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R32">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R32i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/precedesCollectiveAgent"/>
        <regap:name>precedesCollectiveAgent</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A single instance of this relationship can record a simple transformation of a single collective agent into a single successor. Multiple instances of this relationship can be used together to capture the more complex mergers and splits that can occur between and among collective agents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">precedes collective agent</rdfs:label>
        <skos:definition xml:lang="en">Relates two collective agents where the first was transformed into the second</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R32i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R32i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E8"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/succeedsCollectiveAgent"/>
        <regap:name>succeedsCollectiveAgent</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A single instance of this relationship can record a simple transformation of a single collective agent into a single successor. Multiple instances of this relationship can be used together to capture the more complex mergers and splits that can occur between and among collective agents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">succeeds collective agent</rdfs:label>
        <skos:definition xml:lang="en">Relates two collective agents where the second came into being as a transformation of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R33 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R33">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R33i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasAssociationWithPlace"/>
        <regap:name>hasAssociationWithPlace</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In most implementations this relationship would be refined to reflect the exact nature of the association, for example, place of work conception or creation, place of expression creation (e.g., place of musical performance), place of publication or manufacture, current or former location of an item, and location of an agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has association with place</rdfs:label>
        <skos:definition xml:lang="en">Relates any entity with a given extent of space</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R33i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R33i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isAssociatedWithPlace"/>
        <regap:name>isAssociatedWithPlace</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In most implementations this relationship would be refined to reflect the exact nature of the association, for example, place of work conception or creation, place of expression creation (e.g., place of musical performance), place of publication or manufacture, current or former location of an item, and location of an agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is associated with place</rdfs:label>
        <skos:definition xml:lang="en">Relates a place with any entity</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R34 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R34">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R34i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartPlace"/>
        <regap:name>hasPartPlace</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two places where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part place</rdfs:label>
        <skos:definition xml:lang="en">Relates two places where the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R34i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R34i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E10"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isPartPlaceOf"/>
        <regap:name>isPartPlaceOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two places where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part place of</rdfs:label>
        <skos:definition xml:lang="en">Relates two places where the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R35 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R35">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R35i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/HasAssociationWithTime-span"/>
        <regap:name>HasAssociationWithTime-span</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In most implementations this relationship would be refined to reflect the exact nature of the association, for example, time of work conception or creation, time of expression creation (e.g., date/time of musical performance), time of publication or manufacture, period of ownership of an item, date of birth of a person, time of validity of the nomen for a particular res.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has association with time-span</rdfs:label>
        <skos:definition xml:lang="en">Relates any entity with a temporal extent</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R35i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R35i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E1"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/IsAssociatedWithTime-span"/>
        <regap:name>IsAssociatedWithTime-span</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">In most implementations this relationship would be refined to reflect the exact nature of the association, for example, time of work conception or creation, time of expression creation (e.g., date/time of musical performance), time of publication or manufacture, period of ownership of an item, date of birth of a person, time of validity of the nomen for a particular res.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is associated with time-span</rdfs:label>
        <skos:definition xml:lang="en">Relates a time-span with any entity</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R36 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R36">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R36i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/hasPartTime-span"/>
        <regap:name>hasPartTime-span</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two time-spans where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">has part time-span</rdfs:label>
        <skos:definition xml:lang="en">Relates two time-spans where the second is a component of the first</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R36i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R36i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E11"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/IsPartTime-spanOf"/>
        <regap:name>IsPartTime-spanOf</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This is a relationship between two time-spans where one is a component of the other</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is part time-span of</rdfs:label>
        <skos:definition xml:lang="en">Relates two time-spans where the first is a component of the other</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R3i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R3i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/embodies"/>
        <regap:name>embodies</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">A manifestation may embody one or more expressions and any expression may be embodied in one or more manifestations. This logical connection serves as the basis both for identifying the specific expression or expressions of a work or works embodied in an individual manifestation and for ensuring that all manifestations of the same expression are linked back to that expression.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">embodies</rdfs:label>
        <skos:definition xml:lang="en">Relates a manifestation with an expression which appears in the manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R4 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R4">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R4i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/isExemplifiedBy"/>
        <regap:name>isExemplifiedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection serves as the basis both for identifying the manifestation exemplified by an individual item and for ensuring that all items of the same manifestation are linked to that manifestation. Indirectly the relationships between a manifestation and the various items exemplifying that manifestation also serve to establish a “sibling” relationship between the various items of a manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">is exemplified by</rdfs:label>
        <skos:definition xml:lang="en">Relates a manifestation with any item that reflects the characteristics of that manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R4i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R4i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E5"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/exemplifies"/>
        <regap:name>exemplifies</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection serves as the basis both for identifying the manifestation exemplified by an individual item and for ensuring that all items of the same manifestation are linked to that manifestation. Indirectly the relationships between a manifestation and the various items exemplifying that manifestation also serve to establish a “sibling” relationship between the various items of a manifestation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">exemplifies</rdfs:label>
        <skos:definition xml:lang="en">Relates an item with the manifestation whose characteristics are reflected in the item</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R5 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R5">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R5i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasCreatedByWork"/>
        <regap:name>wasCreatedByWork</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between a work and a related agent serves as the basis both for identifying an agent responsible for an individual work and for ensuring that all works by a particular agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was created by work</rdfs:label>
        <skos:definition xml:lang="en">Relates a work to an agent responsible for the creation of the intellectual or artistic content</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R5i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R5i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E2"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/createdWork"/>
        <regap:name>createdWork</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The logical connection between a work and a related agent serves as the basis both for identifying an agent responsible for an individual work and for ensuring that all works by a particular agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">created work</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to a work for which the agent is responsible for the creation of intellectual or artistic content</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R6 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R6">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R6i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasCreatedByExpression"/>
        <regap:name>wasCreatedByExpression</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This relationship applies both to the creation of the original expression and any subsequent modifications such as translations, revisions and performances. An agent responsible for the intellectual or artistic content of a work is responsible for the conception of the work as an abstract entity; an agent responsible for the expression of the work is responsible for the specifics of the intellectual or artistic realization or execution of the expression. The logical connection between an expression and a related agent serves as the basis both for identifying an agent responsible for an individual expression and for ensuring that all expressions realized by an agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was created by expression</rdfs:label>
        <skos:definition xml:lang="en">Relates an expression to an agent responsible for the realization of a work</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R6i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R6i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E3"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/createdExpression"/>
        <regap:name>createdExpression</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">This relationship applies both to the creation of the original expression and any subsequent modifications such as translations, revisions and performances. An agent responsible for the intellectual or artistic content of a work is responsible for the conception of the work as an abstract entity; an agent responsible for the expression of the work is responsible for the specifics of the intellectual or artistic realization or execution of the expression. The logical connection between an expression and a related agent serves as the basis both for identifying an agent responsible for an individual expression and for ensuring that all expressions realized by an agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">created expression</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to an expression in which the agent is responsible for the realization of a work</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R7 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R7">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R7i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasCreatedByManifestation"/>
        <regap:name>wasCreatedByManifestation</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">For a manifestation, the notion of creation broadly includes the publication process for published manifestations. The logical connection between a manifestation and a related agent serves as the basis both for identifying an agent responsible for creating a manifestation and for ensuring that all manifestations created by an agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was created by manifestation</rdfs:label>
        <skos:definition xml:lang="en">Relates a manifestation to an agent responsible for creating the manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R7i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R7i">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/createdManifestation"/>
        <regap:name>createdManifestation</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">For a manifestation, the notion of creation broadly includes the publication process for published manifestations. The logical connection between a manifestation and a related agent serves as the basis both for identifying an agent responsible for creating a manifestation and for ensuring that all manifestations created by an agent are linked to that agent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">created manifestation</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to a manifestation that the agent is responsible for creating</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R8 -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R8">
        <rdfs:subPropertyOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R1"/>
        <owl:inverseOf rdf:resource="http://iflastandards.info/ns/lrm/lrmer/R8i"/>
        <rdfs:domain rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E4"/>
        <rdfs:range rdf:resource="http://iflastandards.info/ns/lrm/lrmer/E6"/>
        <regap:lexicalAlias rdf:resource="http://iflastandards.info/ns/lrm/lrmer/wasManufacturedBy"/>
        <regap:name>wasManufacturedBy</regap:name>
        <regap:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001"/>
        <rdfs:comment xml:lang="en">The manifestation may be manufactured or produced through industrial processes or through artisanal methods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://iflastandards.info/ns/lrm/lrmer"/>
        <rdfs:label xml:lang="en">was manufactured by</rdfs:label>
        <skos:definition xml:lang="en">Relates a manifestation to an agent responsible for the fabrication, production or manufacture of the items of that manifestation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://iflastandards.info/ns/lrm/lrmer/R8i -->

    <owl:ObjectProperty rdf:about="http://iflastandards.info/ns/lrm/lrmer/R8i">
